{
  "identifier": "default",
  "description": "Default capabilities for LifeLogr",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "http://**" },
        { "url": "https://**" }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-read-text"
  ]
}
