# ── Application ──────────────────────────
APP_ENV=development
# IMPORTANT: change this for any non-launcher run — it is the AES key for all
# encrypted cloud-OAuth credentials. The packaged launcher generates
# and persists a strong key automatically; bare `python -m app.main` does not.
SECRET_KEY=change-me-before-production

# ── CORS ─────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Database ─────────────────────────────
# DATABASE_URL is auto-derived from DATA_DIR if not set.
# For explicit control:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ── Data Directories ─────────────────────
# DATA_DIR and MEDIA_DIR auto-derive to platform defaults if not set.
# DATA_DIR defaults to ~/.local/share/lifelogr on Linux
# MEDIA_DIR defaults to {DATA_DIR}/media

# ── Connection Pool (for PostgreSQL only) ─
# SQLite uses pool_size=1 automatically
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# ── Rate Limiting ────────────────────────
RATE_LIMIT=60/minute

# ── Upload Limits ────────────────────────
# MAX_MEDIA_SIZE_BYTES=26214400  # 25 MB

# ── Ollama / AI ──────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_TIMEOUT_SECONDS=300

# ── AI Feature Toggles ───────────────────
# AI_ENABLE_EMBEDDINGS=true
# AI_ENABLE_TAG_SUGGESTIONS=true
# AI_ENABLE_SENTIMENT=true
# AI_ENABLE_SUMMARIZATION=true
# AI_ENABLE_REFLECTION_PROMPTS=true
# AI_ENABLE_WRITER_BLOCK_HELPER=true

# ── Cloud Backup OAuth credentials ───────
# All optional — only configure the providers you use. Redirect URIs must
# match the loopback callback registered in each provider's router.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_CLIENT_SECRET=
# DROPBOX_CLIENT_ID=
# DROPBOX_CLIENT_SECRET=
# BOX_CLIENT_ID=
# BOX_CLIENT_SECRET=

# ── Server bind (non-Docker deploys) ─────
# Only meaningful when launching the backend directly (python -m app.main /
# uvicorn). The Docker image binds 0.0.0.0:8000 regardless; the packaged
# desktop launcher manages these itself.
# BIND_HOST=127.0.0.1
# BIND_PORT=18765
# Shared token the API requires on every request. The only auth gate when the
# API is bound beyond loopback — set it whenever BIND_HOST is not 127.0.0.1.
# API_TOKEN=
# Comma-separated roots a user-supplied backup destination may live under
# (extends the defaults: home, DATA_DIR, system temp).
# BACKUP_ALLOWED_ROOTS=
# Comma-separated extra roots the media import path may read from (e.g.
# /media,/mnt for an external drive). Empty = only DATA_DIR/MEDIA_DIR.
# MEDIA_IMPORT_ALLOWED_ROOTS=
# Cloud archives kept per provider before the retention sweep prunes the
# oldest (applies to scheduled cloud backups).
# BACKUP_CLOUD_RETENTION=5
# Parallel workers for background AI enrichment (tagging/sentiment).
# LIFEOGRF_ENRICHMENT_CONCURRENCY=2

# ── Trash retention ──────────────────────────────────────────────────
# Days a soft-deleted entry stays recoverable before the daily sweep purges
# it (and its media files) permanently. 0 disables the sweep.
# TRASH_RETENTION_DAYS=30
