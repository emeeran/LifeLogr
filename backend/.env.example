# ── Application ──────────────────────────
APP_ENV=development
# IMPORTANT: change this for any non-launcher run — it is the AES key for all
# encrypted cloud-OAuth credentials. The packaged launcher generates
# and persists a strong key automatically; bare `python -m app.main` does not.
SECRET_KEY=change-me-before-production

# ── CORS ─────────────────────────────────
# Keep at least the Tauri origins if you also run the desktop app: this file
# is also loaded from DATA_DIR/.env in packaged runs, and a value that drops
# them makes the desktop webview's API calls fail CORS. The built-in default
# (when CORS_ORIGINS is unset) already includes them plus the loopback SPA
# port — prefer leaving this unset unless you need custom origins.
# CORS_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost,http://127.0.0.1:18765

# ── Data Directories ─────────────────────
# DATA_DIR and MEDIA_DIR auto-derive to platform defaults if not set.
# DATA_DIR defaults to ~/.local/share/lifelogr on Linux
# MEDIA_DIR defaults to {DATA_DIR}/media
# Highest-precedence data-dir override — set by the web-deb launcher;
# beats DATA_DIR and the persisted storage-location setting.
# LIFELOGR_DATA_DIR=

# ── Database ─────────────────────────────
# DATABASE_URL is auto-derived from DATA_DIR if not set.
# For explicit control:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ── Connection Pool ─
# Applies to SQLite too: WAL mode makes a normal-sized pool safe, and the
# defaults exist because hardcoding pool_size=1 froze long background jobs
# (the "entries missing" bug).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# ── Rate Limiting ────────────────────────
RATE_LIMIT=60/minute

# ── Upload Limits ────────────────────────
# MAX_MEDIA_SIZE_BYTES=26214400  # 25 MB
# Import spool cap (JSON/zip/CSV/.diary uploads). Large values spool to disk,
# but the parsed content is held in memory.
# MAX_IMPORT_SIZE_BYTES=2147483648  # 2 GiB

# ── Media encryption (at rest) ───────────
# Encrypt attachment files under MEDIA_DIR for encrypted entries/notes.
# Off by default; entry/note TEXT encryption is independent of this.
# ENCRYPT_MEDIA=false

# ── Network egress toggles (privacy) ─────
# Both default OFF. Enabling either makes the app contact third parties:
# WEATHER_ENABLED pulls forecasts from Open-Meteo for geotagged entries;
# MAP_ONLINE_TILES loads OpenStreetMap tiles in the entry map view.
# WEATHER_ENABLED=false
# MAP_ONLINE_TILES=false

# ── Ollama / AI ──────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_TIMEOUT_SECONDS=300

# ── AI Feature Toggles ───────────────────
# AI_ENABLE_EMBEDDINGS=true
# AI_ENABLE_TAG_SUGGESTIONS=true
# AI_ENABLE_SENTIMENT=true
# AI_ENABLE_SUMMARIZATION=true
# AI_ENABLE_REFLECTION_PROMPTS=true
# AI_ENABLE_WRITER_BLOCK_HELPER=true

# ── Cloud Backup OAuth credentials ───────
# All optional — only configure the providers you use. Redirect URIs must
# match the loopback callback registered in each provider's router.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_CLIENT_SECRET=
# DROPBOX_CLIENT_ID=
# DROPBOX_CLIENT_SECRET=
# BOX_CLIENT_ID=
# BOX_CLIENT_SECRET=

# ── Cache Directories ────────────────────
# Both auto-derive to {DATA_DIR}/… if empty; no need to set them normally.
# TTS_CACHE_DIR=
# WEATHER_CACHE_DIR=

# ── Server bind (non-Docker deploys) ─────
# Only meaningful when launching the backend directly (python -m app.main /
# uvicorn). The Docker image binds 0.0.0.0:8000 regardless; the packaged
# desktop launcher manages these itself.
# BIND_HOST=127.0.0.1
# BIND_PORT=18765
# Shared token the API requires on every request. The only auth gate when the
# API is bound beyond loopback — set it whenever BIND_HOST is not 127.0.0.1.
# API_TOKEN=
# Comma-separated roots a user-supplied backup destination may live under
# (extends the defaults: home, DATA_DIR, system temp).
# BACKUP_ALLOWED_ROOTS=
# Comma-separated extra roots the media import path may read from (e.g.
# /media,/mnt for an external drive). Empty = only DATA_DIR/MEDIA_DIR.
# MEDIA_IMPORT_ALLOWED_ROOTS=
# Cloud archives kept per provider before the retention sweep prunes the
# oldest (applies to scheduled cloud backups).
# BACKUP_CLOUD_RETENTION=5
# Parallel workers for background AI enrichment (tagging/sentiment).
# ENRICHMENT_CONCURRENCY=2

# ── Trash retention ──────────────────────────────────────────────────
# Days a soft-deleted entry stays recoverable before the daily sweep purges
# it (and its media files) permanently. 0 disables the sweep.
# TRASH_RETENTION_DAYS=30
